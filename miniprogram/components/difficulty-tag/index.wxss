.difficulty {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs, 8rpx);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}
.difficulty__glass {
  font-size: 22rpx;
  line-height: 1;
}
.difficulty__label {
  letter-spacing: 0.02em;
}
