<view class="empty-state">
  <view class="empty-state__icon">{{icon}}</view>
  <view class="empty-state__title">{{title}}</view>
  <view class="empty-state__desc" wx:if="{{description}}">{{description}}</view>
  <view class="empty-state__action" wx:if="{{showAction}}" bindtap="onAction">{{actionText}}</view>
</view>
