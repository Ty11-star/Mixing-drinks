.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
  text-align: center;
}
.empty-state__icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--glass-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.empty-state__title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: var(--text);
}
.empty-state__desc {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 16rpx;
  max-width: 460rpx;
  line-height: 1.8;
}
.empty-state__action {
  margin-top: 48rpx;
  padding: 22rpx 56rpx;
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.1em;
  border-radius: 9999rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.28), 0 16rpx 44rpx var(--accent-glow);
}
.empty-state__action:active { transform: scale(0.97); }
