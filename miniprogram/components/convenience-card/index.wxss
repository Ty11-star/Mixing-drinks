/* 组件样式隔离：图标尺寸需在组件内自行定义 */
.ico { width: 40rpx; height: 40rpx; display: block; flex: 0 0 auto; }
.ico-sm { width: 32rpx; height: 32rpx; display: block; flex: 0 0 auto; }

/* 便利店卡片：晨光玻璃质感 */
.c-card {
  --surface: #FFFFFF;
  --glass: rgba(255, 255, 255, 0.88);
  --glass-strong: rgba(255, 255, 255, 0.96);
  --glass-border: rgba(255, 255, 255, 0.95);
  --glass-hi: rgba(255, 255, 255, 0.6);
  --glass-edge: rgba(52, 68, 60, 0.08);
  --text: #222C2C;
  --text-2: #475652;
  --text-3: #6B7873;
  --accent: #96662F;
  --accent-2: #7A6448;
  --accent-soft: rgba(150, 102, 47, 0.10);
  --accent-glow: rgba(150, 102, 47, 0.22);
  --shadow: 0 48rpx 120rpx rgba(52, 68, 60, 0.14);
  --shadow-sm: 0 16rpx 56rpx rgba(52, 68, 60, 0.10);
  --shadow-lifted: 0 32rpx 80rpx rgba(52, 68, 60, 0.16);
  --card-veil: linear-gradient(180deg, transparent 32%, rgba(32, 42, 40, 0.08) 52%, rgba(28, 38, 36, 0.82) 100%);
  --hero-veil: linear-gradient(180deg, rgba(233, 235, 230, 0.28) 0%, rgba(233, 235, 230, 0.06) 38%, rgba(233, 235, 230, 0.72) 85%, #E9EBE6 100%);
  --divider: rgba(34, 44, 44, 0.10);
  background: var(--glass);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 56rpx rgba(52, 68, 60, 0.10);
}
.c-card.is-dark {
  --text: #F2ECE2;
  --text-2: #A6B5BF;
  --text-3: #8FA0AC;
  --accent: #D9AE7C;
  --accent-soft: rgba(217, 174, 124, 0.14);
  --glass-border: rgba(255, 255, 255, 0.14);
  background: #162430;
  box-shadow: 0 16rpx 56rpx rgba(0, 0, 0, 0.3);
}
.c-card__image {
  position: relative;
  height: 300rpx;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.c-card.is-dark .c-card__fav {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.16);
}
.c-card__emoji { font-size: 100rpx; line-height: 1; }
.c-card__photo {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0; transition: opacity 0.4s ease;
}
.c-card__photo.is-loaded { opacity: 1; }
.c-card__fav {
  position: absolute; top: 24rpx; right: 24rpx;
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--glass-border);
}
.c-card__body { padding: 28rpx 32rpx 32rpx; }
.c-card__name { font-family: var(--font-display); font-size: 34rpx; font-weight: 400; color: var(--text); }
.c-card__en { font-family: var(--font-mono); font-style: italic; font-size: 24rpx; color: var(--text-3); margin-top: 4rpx; }
.c-card__foot { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.c-card__tag {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: 22rpx; color: var(--accent);
  background: var(--accent-soft);
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
}
.c-card__tag .ico-sm { width: 28rpx; height: 28rpx; }
.c-card__step { font-size: 22rpx; color: var(--text-3); }


.theme-dark {
  --surface: #162430;
  --glass: rgba(255, 255, 255, 0.055);
  --glass-strong: rgba(255, 255, 255, 0.095);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-hi: rgba(255, 255, 255, 0.20);
  --glass-edge: rgba(255, 255, 255, 0.14);
  --text: #F2ECE2;
  --text-2: #A6B5BF;
  --text-3: #96A6B2;
  --accent: #D9AE7C;
  --accent-2: #C08E77;
  --accent-soft: rgba(217, 174, 124, 0.14);
  --accent-glow: rgba(217, 174, 124, 0.30);
  --shadow: 0 48rpx 120rpx rgba(0, 0, 0, 0.42);
  --shadow-sm: 0 16rpx 56rpx rgba(0, 0, 0, 0.30);
  --shadow-lifted: 0 32rpx 80rpx rgba(0, 0, 0, 0.5);
  --card-veil: linear-gradient(180deg, transparent 32%, rgba(6, 14, 20, 0.18) 52%, rgba(6, 14, 20, 0.88) 100%);
  --hero-veil: linear-gradient(180deg, rgba(10, 20, 27, 0.30) 0%, rgba(10, 20, 27, 0.58) 48%, #0A141B 100%);
  --divider: rgba(255, 255, 255, 0.09);
}