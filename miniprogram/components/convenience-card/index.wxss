.c-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 96, 0.12);
  transition: transform 0.2s;
}
.c-card:active { transform: scale(0.98); }

.c-card__image {
  position: relative;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.c-card__emoji {
  font-size: 120rpx;
  line-height: 1;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.12));
}
.c-card__cost {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #E65100;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.c-card__fav {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  color: #7CB342;
  font-size: 36rpx;
  line-height: 1;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.12);
}
.c-card__fav.is-fav { color: #FF7043; }

.c-card__body { padding: 20rpx 22rpx 24rpx; }
.c-card__name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E3A2E;
  line-height: 1.3;
}
.c-card__en {
  font-size: 22rpx;
  color: #8A9A8A;
  margin-top: 4rpx;
}
.c-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F4F0;
}
.c-card__tag {
  font-size: 22rpx;
  color: #558B2F;
  background: #F1F8E9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.c-card__step {
  font-size: 22rpx;
  color: #8A9A8A;
}
