/* 组件样式隔离：图标尺寸需在组件内自行定义 */
.ico { width: 40rpx; height: 40rpx; display: block; flex: 0 0 auto; }
.ico-sm { width: 32rpx; height: 32rpx; display: block; flex: 0 0 auto; }

/* 精选卡片：整图铺底 + 暖调渐隐 + 叠字（对齐 HTML 原型） */
.cocktail-card {
  --surface: #FFFFFF;
  --glass: rgba(255, 255, 255, 0.88);
  --glass-strong: rgba(255, 255, 255, 0.96);
  --glass-border: rgba(255, 255, 255, 0.95);
  --glass-hi: rgba(255, 255, 255, 0.6);
  --glass-edge: rgba(52, 68, 60, 0.08);
  --text: #222C2C;
  --text-2: #475652;
  --text-3: #6B7873;
  --accent: #96662F;
  --accent-2: #7A6448;
  --accent-soft: rgba(150, 102, 47, 0.10);
  --accent-glow: rgba(150, 102, 47, 0.22);
  --shadow: 0 48rpx 120rpx rgba(52, 68, 60, 0.14);
  --shadow-sm: 0 16rpx 56rpx rgba(52, 68, 60, 0.10);
  --shadow-lifted: 0 32rpx 80rpx rgba(52, 68, 60, 0.16);
  --card-veil: linear-gradient(180deg, transparent 32%, rgba(32, 42, 40, 0.08) 52%, rgba(28, 38, 36, 0.82) 100%);
  --hero-veil: linear-gradient(180deg, rgba(233, 235, 230, 0.28) 0%, rgba(233, 235, 230, 0.06) 38%, rgba(233, 235, 230, 0.72) 85%, #E9EBE6 100%);
  --divider: rgba(34, 44, 44, 0.10);
  --radius-lg: 32rpx;
  --radius-md: 24rpx;
  --dur: .45s;
  --ease: cubic-bezier(.22,.61,.36,1);
  position: relative;
  height: 536rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.cocktail-card--hover {
  transform: translateY(-12rpx);
  box-shadow: var(--shadow-lifted);
}
.cocktail-card__image {
  position: absolute;
  inset: 0;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.cocktail-card__icon { font-size: 120rpx; line-height: 1; opacity: 0.85; }
.cocktail-card__photo {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
  filter: saturate(0.9);
  transition: opacity 0.45s ease, transform 0.8s var(--ease);
}
.cocktail-card__photo.is-loaded { opacity: 1; }
.cocktail-card--hover .cocktail-card__photo.is-loaded { transform: scale(1.06); }
.cocktail-card__veil {
  position: absolute; inset: 0;
  background: var(--card-veil);
}
.cocktail-card__fav {
  position: absolute; top: 24rpx; right: 24rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.cocktail-card__body {
  position: absolute; left: 36rpx; right: 36rpx; bottom: 36rpx;
  display: flex; flex-direction: column; gap: 4rpx;
}
.cocktail-card__title {
  font-family: var(--font-display);
  font-weight: 400; font-size: 38rpx;
  letter-spacing: 0.06em;
  color: #FBF7EF;
}
.cocktail-card__subtitle {
  font-family: var(--font-mono);
  font-style: italic; font-size: 28rpx;
  color: rgba(251, 247, 239, 0.72);
}
.cocktail-card__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.02em;
  color: rgba(251, 247, 239, 0.78);
}


.theme-dark {
  --surface: #162430;
  --glass: rgba(255, 255, 255, 0.055);
  --glass-strong: rgba(255, 255, 255, 0.095);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-hi: rgba(255, 255, 255, 0.20);
  --glass-edge: rgba(255, 255, 255, 0.14);
  --text: #F2ECE2;
  --text-2: #A6B5BF;
  --text-3: #96A6B2;
  --accent: #D9AE7C;
  --accent-2: #C08E77;
  --accent-soft: rgba(217, 174, 124, 0.14);
  --accent-glow: rgba(217, 174, 124, 0.30);
  --shadow: 0 48rpx 120rpx rgba(0, 0, 0, 0.42);
  --shadow-sm: 0 16rpx 56rpx rgba(0, 0, 0, 0.30);
  --shadow-lifted: 0 32rpx 80rpx rgba(0, 0, 0, 0.5);
  --card-veil: linear-gradient(180deg, transparent 32%, rgba(6, 14, 20, 0.18) 52%, rgba(6, 14, 20, 0.88) 100%);
  --hero-veil: linear-gradient(180deg, rgba(10, 20, 27, 0.30) 0%, rgba(10, 20, 27, 0.58) 48%, #0A141B 100%);
  --divider: rgba(255, 255, 255, 0.09);
}