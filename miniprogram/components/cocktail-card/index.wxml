<view class="cocktail-card" bindtap="goDetail" hover-class="cocktail-card--hover">
  <view class="cocktail-card__image" style="background:{{gradient}}">
    <text class="cocktail-card__icon">{{icon}}</text>
    <image
      wx:if="{{image}}"
      class="cocktail-card__photo {{imageLoaded ? 'is-loaded' : ''}}"
      src="{{image}}"
      mode="aspectFill"
      lazy-load="{{true}}"
      show-menu-by-longpress="{{false}}"
      bindload="onImageLoad"
    ></image>
    <view class="cocktail-card__veil"></view>
    <view class="cocktail-card__fav {{isFav ? 'is-fav' : ''}}" catchtap="toggleFav">
      <image class="ico ico-sm" src="{{isFav ? icons.heartFilled : icons.heartOutline}}" />
    </view>
    <view class="cocktail-card__body">
      <view class="cocktail-card__title ellipsis">{{cocktail.name}}</view>
      <view class="cocktail-card__subtitle ellipsis" wx:if="{{cocktail.nameEn}}">{{cocktail.nameEn}}</view>
      <view class="cocktail-card__desc" wx:if="{{taste.length}}">{{taste[0]}} · {{cocktail.baseSpirit}}</view>
    </view>
  </view>
</view>
