.conv-detail { padding: 0; }

.cd-hero {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 0 0 40rpx 40rpx;
}
.cd-hero__emoji {
  font-size: 220rpx;
  line-height: 1;
  filter: drop-shadow(0 16rpx 24rpx rgba(0,0,0,0.12));
}
.cd-hero__cost {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  background: #FFFFFF;
  color: #E65100;
  font-size: 28rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.cd-main { padding: 32rpx; }
.cd-title__name {
  font-family: var(--font-display, serif);
  font-size: 48rpx;
  font-weight: 700;
  color: #1B5E20;
}
.cd-title__en { font-size: 26rpx; color: #7CB342; margin-top: 6rpx; }
.cd-title__tags { display: flex; gap: 14rpx; margin-top: 20rpx; flex-wrap: wrap; }
.cd-title__tag {
  font-size: 24rpx;
  color: #2E7D32;
  background: #F1F8E9;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.cd-section { margin-top: 48rpx; }
.cd-section__head {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E3A2E;
  margin-bottom: 20rpx;
}
.cd-mat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(46,125,50,0.08);
}
.cd-mat__emoji { font-size: 44rpx; }
.cd-mat__name { flex: 1; font-size: 28rpx; color: #2E3A2E; }
.cd-mat__amount { font-size: 26rpx; color: #7CB342; }
.cd-buy-tip {
  font-size: 22rpx;
  color: #8A9A8A;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
}

.cd-step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.cd-step__num {
  flex: 0 0 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.cd-step__text {
  flex: 1;
  font-size: 28rpx;
  color: #3E4A3E;
  line-height: 1.7;
  padding-top: 8rpx;
}

.cd-tips {
  margin-top: 48rpx;
  background: #F1F8E9;
  border-left: 6rpx solid #8BC34A;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.cd-tips__head { font-size: 28rpx; font-weight: 700; color: #33691E; margin-bottom: 12rpx; }
.cd-tips__body { font-size: 26rpx; color: #558B2F; line-height: 1.7; }

.cd-actions { margin-top: 48rpx; }
.cd-fav {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #A5D6A7;
  color: #2E7D32;
  font-size: 30rpx;
  font-weight: 600;
}
.cd-fav.is-fav {
  background: linear-gradient(135deg, #FFAB91, #FF8A65);
  border-color: transparent;
  color: #FFFFFF;
}
