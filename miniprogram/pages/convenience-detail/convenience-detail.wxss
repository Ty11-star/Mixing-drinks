.conv-detail { padding: 0; }

.cd-hero {
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 420rpx 340rpx at 50% 30%, var(--orb-warm), transparent 72%),
    var(--hero-gradient);
}
.cd-hero__emoji {
  font-size: 240rpx;
  line-height: 1;
  filter: drop-shadow(0 20rpx 32rpx rgba(52, 68, 60, 0.16));
}
.cd-hero__cost {
  position: absolute; right: 48rpx; top: calc(48rpx + env(safe-area-inset-top));
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 30rpx;
  padding: 12rpx 30rpx;
  border-radius: 9999rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}

.cd-main { padding: 48rpx 60rpx 0; }
.cd-title__name {
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 300;
  letter-spacing: 0.04em;
  color: var(--text);
}
.cd-title__en { font-family: var(--font-mono); font-style: italic; font-size: 30rpx; color: var(--accent); margin-top: 8rpx; }
.cd-title__tags { display: flex; gap: 16rpx; margin-top: 28rpx; flex-wrap: wrap; }
.cd-title__tag {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
}

.cd-section { margin-top: 72rpx; }
.cd-section__head {
  font-family: var(--font-display);
  font-size: 38rpx; font-weight: 400;
  letter-spacing: 0.08em;
  color: var(--text);
  margin-bottom: 28rpx;
}
.cd-mat {
  display: flex; align-items: center; gap: 24rpx;
  padding: 26rpx 32rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.cd-mat__emoji { font-size: 48rpx; }
.cd-mat__name { flex: 1; font-size: 28rpx; color: var(--text); }
.cd-mat__amount { font-family: var(--font-mono); font-size: 30rpx; color: var(--accent); }
.cd-buy-tip {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--accent-soft);
  border-radius: var(--radius-sm);
  line-height: 1.8;
}

.cd-step { display: flex; gap: 28rpx; margin-bottom: 36rpx; align-items: flex-start; }
.cd-step__num {
  flex: 0 0 60rpx; height: 60rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  border: 1rpx solid rgba(168,120,68,0.2);
  color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 34rpx;
}
.cd-step__text { flex: 1; font-size: 28rpx; color: var(--text-2); line-height: 1.95; padding-top: 6rpx; }

.cd-tips {
  margin-top: 72rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 36rpx 40rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.cd-tips__head { font-family: var(--font-display); font-size: 26rpx; font-weight: 400; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 16rpx; }
.cd-tips__body { font-size: 26rpx; color: var(--text-2); line-height: 2; }

.cd-actions { margin-top: 72rpx; }
.cd-fav {
  height: 104rpx;
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  border-radius: 9999rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  color: var(--text-2);
  font-family: var(--font-display);
  font-size: 30rpx; letter-spacing: 0.1em;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.cd-fav.is-fav {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  border-color: transparent;
  color: #FFFFFF;
  box-shadow: 0 16rpx 44rpx var(--accent-glow);
}
