<view class="page-wrap detail {{isDark ? 'theme-dark' : ''}}">

  <pour-loading wx:if="{{loading}}" text="正在倒酒…"></pour-loading>

  <block wx:elif="{{detail}}">
    <!-- 视差封面 -->
    <view class="hero">
      <view class="hero__bg" style="transform:translateY({{scrollTop * 0.3}}px);opacity:{{1 - scrollTop / 320 > 0.2 ? 1 - scrollTop / 320 : 0.2}};background:{{gradient}}">
        <image wx:if="{{image}}" class="hero__photo" src="{{image}}" mode="aspectFill" lazy-load="{{true}}" show-menu-by-longpress="{{false}}"></image>
        <text wx:else class="hero__watermark">{{icon}}</text>
      </view>
      <view class="hero__veil"></view>

      <view class="hero__top">
        <view class="icon-btn" bindtap="goBack"><image class="ico" src="{{icons.back}}" /></view>
        <view class="icon-btn {{isFav ? 'faved' : ''}}" bindtap="toggleFav">
          <image class="ico" src="{{isFav ? icons.heartFilled : icons.heartOutline}}" />
        </view>
      </view>

      <view class="hero__content" style="transform:translateY({{scrollTop * 0.12}}px)">
        <view class="hero__kicker">今夜的第一杯</view>
        <view class="hero__name">{{detail.name}}</view>
        <view class="hero__en" wx:if="{{detail.nameEn}}">{{detail.nameEn}}</view>
        <view class="hero__tags" wx:if="{{taste.length}}">
          <text wx:for="{{taste}}" wx:key="*this" wx:for-item="t" class="hero__tag">{{t}}</text>
        </view>
      </view>
    </view>

    <!-- 内容纸张 -->
    <view class="sheet">
      <view class="sheet__handle"></view>

      <view class="desc">{{detail.description}}</view>

      <!-- 基础信息 -->
      <view class="meta-row">
        <view class="meta-item"><text class="meta-item__v">{{methodLabel}}</text><text class="meta-item__k">调制</text></view>
        <view class="meta-item" wx:if="{{detail.glassType}}"><text class="meta-item__v">{{detail.glassType}}</text><text class="meta-item__k">杯型</text></view>
        <view class="meta-item" wx:if="{{detail.alcoholContent}}"><text class="meta-item__v">{{detail.alcoholContent}}</text><text class="meta-item__k">酒精</text></view>
        <view class="meta-item" wx:if="{{detail.iceType}}"><text class="meta-item__v">{{detail.iceType}}</text><text class="meta-item__k">冰型</text></view>
      </view>

      <!-- 材料 -->
      <view class="block">
        <view class="block__head"><text class="block__title">需要这些</text><text class="block__en">ingredients</text></view>
        <view class="ing" wx:for="{{ingredients}}" wx:key="id">
          <view class="ing__name"><view class="ing__dot"></view><text>{{item.name}}</text></view>
          <view class="ing__amount">{{item.amount}}</view>
        </view>
      </view>

      <!-- 步骤 -->
      <view class="block">
        <view class="block__head"><text class="block__title">慢慢来</text><text class="block__en">steps</text></view>
        <view class="step" wx:for="{{detail.steps}}" wx:key="stepNumber">
          <view class="step__num">{{item.stepNumber}}</view>
          <view class="step__body">
            <view class="step__desc">{{item.description}}</view>
          </view>
        </view>
      </view>

      <!-- 小贴士 -->
      <view class="tip card" wx:if="{{detail.tips}}">
        <view class="tip__label">一点小提醒</view>
        <view class="tip__text">{{detail.tips}}</view>
      </view>
    </view>

    <view class="drink-disclaimer">未成年人请勿饮酒 · 理性饮酒</view>
    <view class="safe-bottom"></view>
  </block>

  <empty-state wx:else icon="🥺" title="找不到这款酒" description="它可能已下架或链接有误"></empty-state>

  <!-- 底部操作栏：玻璃胶囊 -->
  <view class="action-bar" wx:if="{{detail && !loading}}">
    <view class="action-bar__fav {{isFav ? 'on' : ''}} {{favRipple ? 'ripple' : ''}}" bindtap="toggleFav">
      <image class="ico" src="{{isFav ? icons.heartFilled : icons.heartOutline}}" />
    </view>
    <button class="action-bar__share" open-type="share">分享给朋友</button>
  </view>
</view>
