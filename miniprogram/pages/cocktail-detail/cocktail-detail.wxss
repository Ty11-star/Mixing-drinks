.detail { padding: 0; }

/* —— 视差封面 —— */
.hero {
  position: relative;
  height: 860rpx;
  overflow: hidden;
}
.hero__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  background-size: cover;
}
.hero__watermark { font-size: 400rpx; line-height: 1; opacity: 0.9; }
.hero__photo { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.hero__veil {
  position: absolute; inset: 0;
  background: var(--hero-veil);
}
.hero__top {
  position: absolute;
  top: calc(40rpx + env(safe-area-inset-top)); left: 48rpx; right: 48rpx;
  z-index: 5;
  display: flex; justify-content: space-between;
}
.icon-btn {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.icon-btn.faved .ico { filter: none; }
.hero__content {
  position: absolute;
  left: 60rpx; right: 60rpx; bottom: 120rpx;
  z-index: 4;
}
.hero__kicker {
  font-family: var(--font-display);
  font-size: 22rpx; letter-spacing: 0.26em;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.hero__name {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: 84rpx;
  line-height: 1.15;
  letter-spacing: 0.06em;
  color: var(--text);
}
.hero__en {
  font-family: var(--font-mono);
  font-style: italic;
  font-size: 46rpx;
  color: var(--accent);
  margin-top: 8rpx;
}
.hero__tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 32rpx; }
.hero__tag {
  font-size: 20rpx; letter-spacing: 0.12em;
  padding: 12rpx 26rpx;
  border-radius: 9999rpx;
  color: var(--text-2);
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
}

/* —— 内容纸张 —— */
.sheet {
  position: relative;
  margin-top: -40rpx;
  padding: 40rpx 60rpx 0;
  border-radius: 72rpx 72rpx 0 0;
  background: var(--bg);
  z-index: 6;
}
.sheet__handle {
  width: 72rpx; height: 8rpx;
  border-radius: 8rpx;
  background: var(--divider);
  margin: 0 auto 56rpx;
}
.desc {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: 30rpx;
  line-height: 2.15;
  letter-spacing: 0.035em;
  color: var(--text-2);
}

/* —— 基础信息 —— */
.meta-row {
  display: flex;
  padding: 52rpx 0;
  margin-top: 44rpx;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}
.meta-item {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.meta-item__v { font-family: var(--font-display); font-size: 28rpx; color: var(--text); letter-spacing: 0.04em; }
.meta-item__k { font-size: 20rpx; letter-spacing: 0.14em; color: var(--text-3); }

/* —— 区块 —— */
.block { margin-top: 88rpx; }
.block__head { display: flex; align-items: baseline; gap: 20rpx; margin-bottom: 40rpx; }
.block__title {
  font-family: var(--font-display);
  font-weight: 400; font-size: 40rpx;
  letter-spacing: 0.1em; color: var(--text);
}
.block__en {
  font-family: var(--font-mono); font-style: italic;
  font-size: 28rpx; color: var(--text-3);
}

/* —— 材料 —— */
.ing {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.ing:last-child { border-bottom: 0; }
.ing__name { display: flex; align-items: center; gap: 24rpx; font-size: 26rpx; letter-spacing: 0.05em; color: var(--text); }
.ing__dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--accent); box-shadow: 0 0 0 8rpx var(--accent-soft);
}
.ing__amount { font-family: var(--font-mono); font-size: 32rpx; color: var(--text-2); }

/* —— 步骤 —— */
.step { display: flex; gap: 32rpx; position: relative; padding-bottom: 52rpx; }
.step:last-child { padding-bottom: 0; }
.step::before {
  content: ''; position: absolute;
  left: 30rpx; top: 68rpx; bottom: 0; width: 1rpx;
  background: linear-gradient(var(--divider), transparent);
}
.step:last-child::before { display: none; }
.step__num {
  flex: 0 0 60rpx; width: 60rpx; height: 60rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 34rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1rpx solid rgba(168, 120, 68, 0.2);
}
.step__body { flex: 1; padding-top: 6rpx; }
.step__desc { font-size: 26rpx; line-height: 1.95; color: var(--text-2); letter-spacing: 0.025em; }

/* —— 小贴士 —— */
.tip { margin-top: 88rpx; padding: 44rpx 40rpx; }
.tip__label {
  font-family: var(--font-display);
  font-size: 22rpx; letter-spacing: 0.2em;
  color: var(--accent); margin-bottom: 20rpx;
}
.tip__text { font-size: 24rpx; line-height: 2; color: var(--text-2); letter-spacing: 0.03em; }

/* —— 底部操作栏：玻璃胶囊 —— */
.action-bar {
  position: fixed;
  left: 40rpx; right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 132rpx;
  border-radius: 9999rpx;
  display: flex; align-items: center; gap: 16rpx;
  padding: 10rpx 12rpx 10rpx 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--glass-edge);
  box-shadow: 0 12rpx 40rpx rgba(52, 68, 60, 0.14);
  z-index: 50;
}
.action-bar__fav {
  flex: 0 0 108rpx; height: 108rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  position: relative; overflow: hidden;
}
.action-bar__fav.on { background: var(--accent-soft); }
.action-bar__fav.ripple::after {
  content: ''; position: absolute;
  width: 20rpx; height: 20rpx; border-radius: 50%;
  background: var(--accent-glow);
  left: 50%; top: 50%;
  transform: translate(-50%, -50%) scale(0);
  animation: fav-ripple 0.6s ease-out;
}
@keyframes fav-ripple {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0.7; }
  100% { transform: translate(-50%, -50%) scale(18); opacity: 0; }
}
.action-bar__share {
  flex: 1; height: 108rpx;
  background: linear-gradient(120deg, var(--accent), var(--accent-2)) !important;
  color: #FFFFFF !important;
  font-family: var(--font-display);
  font-size: 28rpx; font-weight: 400; letter-spacing: 0.14em;
  border-radius: 9999rpx;
  display: flex; align-items: center; justify-content: center;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5), 0 16rpx 44rpx var(--accent-glow);
  border: 0 !important;
}
.action-bar__share::after { border: none; }
