.knowledge { padding: 0; }

.know-hero {
  background:
    radial-gradient(ellipse 420rpx 320rpx at 86% 0%, var(--orb-warm), transparent 70%),
    var(--head-gradient);
  padding: calc(48rpx + env(safe-area-inset-top)) 48rpx 52rpx;
  border-radius: 0 0 56rpx 56rpx;
}
.know-hero__title { font-family: var(--font-display); font-size: 52rpx; font-weight: 400; letter-spacing: 0.04em; color: var(--text); }
.know-hero__sub { font-size: 24rpx; color: var(--text-2); margin-top: 10rpx; letter-spacing: 0.04em; }

.tabs {
  margin-top: -24rpx;
  padding: 0 16rpx;
}
.tabs__scroll { white-space: nowrap; }
.tab {
  display: inline-block;
  margin: 0 8rpx;
  padding: 14rpx 36rpx;
  background: var(--glass-strong); border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-round, 9999rpx);
  font-size: 27rpx;
  color: var(--text-2);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}
.tab.on {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
}

.know-list { padding: 24rpx 32rpx 0; }
.know-item { padding: 28rpx; margin-bottom: 20rpx; }
.know-item__name {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}
.know-item__name::before {
  content: '';
  display: inline-block;
  width: 10rpx; height: 28rpx;
  background: var(--accent);
  border-radius: var(--radius-xs);
  margin-right: 14rpx;
  vertical-align: -3rpx;
}
.know-item__desc { font-size: 27rpx; color: var(--text-2); line-height: 1.75; }
