.knowledge { padding: 0; }

.know-hero {
  background: linear-gradient(160deg, var(--midnight-blue, #1A2332), var(--slate-blue, #3D5A7B));
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.know-hero__title { font-family: var(--font-display, serif); font-size: 46rpx; font-weight: 700; color: #FFFFFF; }
.know-hero__sub { font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 8rpx; }

.tabs {
  margin-top: -24rpx;
  padding: 0 16rpx;
}
.tabs__scroll { white-space: nowrap; }
.tab {
  display: inline-block;
  margin: 0 8rpx;
  padding: 14rpx 36rpx;
  background: #FFFFFF;
  border-radius: var(--radius-round, 9999rpx);
  font-size: 27rpx;
  color: var(--slate-blue, #3D5A7B);
  box-shadow: var(--shadow-glass-light, 0 4rpx 12rpx rgba(26,35,50,0.08));
  transition: all 0.2s;
}
.tab.on {
  background: linear-gradient(135deg, var(--primary-amber, #D4A574), var(--primary-amber-dark, #B8935E));
  color: #FFFFFF;
}

.know-list { padding: 24rpx 32rpx 0; }
.know-item { padding: 28rpx; margin-bottom: 20rpx; }
.know-item__name {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--midnight-blue, #1A2332);
  margin-bottom: 12rpx;
}
.know-item__name::before {
  content: '';
  display: inline-block;
  width: 10rpx; height: 28rpx;
  background: var(--primary-amber, #D4A574);
  border-radius: var(--radius-xs, 8rpx);
  margin-right: 14rpx;
  vertical-align: -3rpx;
}
.know-item__desc { font-size: 27rpx; color: var(--slate-blue, #3D5A7B); line-height: 1.75; }
