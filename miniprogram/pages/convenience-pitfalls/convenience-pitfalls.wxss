.pit-page { padding: 0; }

.pit-header {
  padding: 48rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 0 0 32rpx 32rpx;
}
.pit-header__title { font-size: 40rpx; font-weight: 700; color: #E65100; }
.pit-header__sub { font-size: 24rpx; color: #B8860B; margin-top: 12rpx; }

.pit-list { padding: 32rpx; }
.pit-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(230,81,0,0.08);
}
.pit-item__icon { font-size: 44rpx; line-height: 1.2; }
.pit-item__body { flex: 1; }
.pit-item__title { font-size: 30rpx; font-weight: 700; color: #3E3A2E; }
.pit-item__desc { font-size: 26rpx; color: #7A7568; line-height: 1.7; margin-top: 10rpx; }

.pit-footer {
  text-align: center;
  font-size: 26rpx;
  color: #8A9A8A;
  padding: 20rpx 32rpx 40rpx;
}
