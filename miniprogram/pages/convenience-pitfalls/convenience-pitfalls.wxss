.pit-page { padding: 0; }

.pit-header {
  padding: calc(48rpx + env(safe-area-inset-top)) 48rpx 40rpx;
  background:
    radial-gradient(ellipse 420rpx 320rpx at 88% 0%, var(--orb-warm), transparent 70%),
    var(--head-gradient);
  border-radius: 0 0 56rpx 56rpx;
}
.pit-header__title { font-family: var(--font-display); font-size: 46rpx; font-weight: 400; letter-spacing: 0.04em; color: var(--text); }
.pit-header__sub { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; letter-spacing: 0.04em; }

.pit-list { padding: 40rpx 48rpx; }
.pit-item {
  display: flex; gap: 24rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.pit-item__icon { font-size: 48rpx; line-height: 1.2; }
.pit-item__body { flex: 1; }
.pit-item__title { font-family: var(--font-display); font-size: 32rpx; font-weight: 400; color: var(--text); }
.pit-item__desc { font-size: 26rpx; color: var(--text-2); line-height: 1.9; margin-top: 12rpx; }

.pit-footer {
  text-align: center;
  font-family: var(--font-display);
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 0.06em;
  padding: 32rpx 48rpx 40rpx;
}
