<view class="page-wrap index {{mode === 'convenience' ? 'index--conv' : ''}} {{isDark ? 'theme-dark' : ''}}">

  <!-- 模式切换：玻璃胶囊 -->
  <view class="switch-wrap">
    <view class="mode-switch">
      <view class="mode-switch__item {{mode === 'pro' ? 'is-active' : ''}}" data-mode="pro" bindtap="switchMode">专业调酒</view>
      <view class="mode-switch__item {{mode === 'convenience' ? 'is-active' : ''}}" data-mode="convenience" bindtap="switchMode">便利店调酒</view>
    </view>
  </view>

  <!-- ============ 专业调酒模式 ============ -->
  <block wx:if="{{mode === 'pro'}}">
    <!-- 沉浸 Hero -->
    <view class="hero rise">
      <image wx:if="{{heroImage}}" class="hero__photo" src="{{heroImage}}" mode="aspectFill" />
      <view class="hero__photo-veil"></view>
      <view class="hero__glow"></view>
      <view class="hero__bar">
        <view class="brandmark">
          <text class="brandmark__zh">慢酌</text>
          <text class="brandmark__en">Slow SIP</text>
        </view>
        <view class="hero__mine ripple-btn" bindtap="goMine">
          <image class="ico" src="{{icons.user}}" />
        </view>
      </view>

      <view class="hero__copy">
        <view class="hero__kicker"><view class="hero__kicker-line"></view><text>今夜适合慢一点</text></view>
        <view class="hero__title"><view>把夜晚，</view><view>调<text class="hero__title-em">慢</text>一点</view></view>
        <view class="hero__sub"><view>为此刻的心情，找一杯合适的酒。</view><view>不必着急，慢慢挑。</view></view>
        <view class="search-pill" bindtap="goSearch">
          <image class="ico ico-sm" src="{{icons.searchAccent}}" />
          <text>想喝点什么味道？</text>
        </view>
        <view class="scroll-hint"><view class="scroll-hint__line"></view><text>往下，慢慢看</text></view>
      </view>
    </view>

    <!-- 此刻推荐 -->
    <view class="section">
      <view class="section__head">
        <view class="section__title">此刻推荐<text class="section__en">for tonight</text></view>
        <view class="section__more" bindtap="toggleView">{{viewMode === 'grid' ? '列表' : '网格'}} ›</view>
      </view>
    </view>

    <!-- 基酒筛选：横滑胶囊 -->
    <view class="spirit-tabs">
      <scroll-view scroll-x class="spirit-tabs__scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="spirit-tab {{baseSpirit === item.name ? 'active' : ''}}"
          wx:for="{{spirits}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="selectSpirit"
        >{{item.label}}</view>
      </scroll-view>
    </view>

    <view class="toolbar">
      <view class="toolbar__count">共 <text class="text-amber fw-600">{{total}}</text> 款</view>
    </view>

    <pour-loading wx:if="{{loading && list.length === 0}}" text="正在调酒…"></pour-loading>

    <empty-state
      wx:elif="{{!loading && list.length === 0}}"
      icon="🍹"
      title="暂无可调之酒"
      description="换个基酒试试，或先去添加你手头的材料"
      show-action="{{true}}"
      action-text="去调一杯"
      bind:action="goIngredient"
    ></empty-state>

    <!-- 网格视图 -->
    <view class="grid" wx:elif="{{viewMode === 'grid'}}">
      <view class="grid__col" wx:for="{{list}}" wx:key="id">
        <cocktail-card cocktail="{{item}}"></cocktail-card>
      </view>
    </view>

    <!-- 列表视图：横向大图卡片，风格对齐网格 -->
    <view class="list" wx:else>
      <view class="list-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="list-card--hover">
        <view class="list-card__image" style="background:{{item._gradient}}">
          <text class="list-card__icon">{{item._icon}}</text>
          <image
            wx:if="{{item.image}}"
            class="list-card__photo {{item._imgLoaded ? 'is-loaded' : ''}}"
            src="{{item.image}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            show-menu-by-longpress="{{false}}"
            data-id="{{item.id}}"
            bindload="onListImageLoad"
          ></image>
          <view class="list-card__veil"></view>
          <view class="list-card__fav {{item._isFav ? 'is-fav' : ''}}" data-id="{{item.id}}" catchtap="toggleFav">
            <image class="ico ico-sm" src="{{item._isFav ? icons.heartFilled : icons.heartOutline}}" />
          </view>
          <view class="list-card__body">
            <view class="list-card__title ellipsis">{{item.name}}</view>
            <view class="list-card__subtitle ellipsis" wx:if="{{item.nameEn}}">{{item.nameEn}}</view>
            <view class="list-card__desc">
              <text class="list-card__spirit">{{item.baseSpirit}}</text>
              <text class="list-card__dot">·</text>
              <text>{{item._diff.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{list.length > 0}}">
      <text wx:if="{{loading}}">倒酒中…</text>
      <text wx:elif="{{finished}}">— 到底啦 —</text>
      <text wx:else>上拉加载更多</text>
    </view>

    <!-- 引言 -->
    <view class="quote-block card">
      <text>喝酒这件事，喝的从来不只是酒。</text>
      <text class="quote-block__em">是停下来那一刻的自己。</text>
    </view>
  </block>

  <!-- ============ 便利店调酒模式 ============ -->
  <block wx:else>
    <view class="conv-hero rise">
      <view class="conv-hero__glow"></view>
      <view class="conv-hero__bar">
        <view class="brandmark">
          <text class="brandmark__zh">便利店调酒</text>
          <text class="brandmark__en">Easy &amp; Anytime</text>
        </view>
        <image class="ico ico-lg" src="{{icons.basketAccent}}" />
      </view>
      <view class="conv-hero__slogan">不用买基酒，下楼就能调。</view>
      <view class="conv-hero__match" bindtap="goConvenienceMatch">
        <view class="conv-hero__match-icon"><image class="ico ico-lg" src="{{icons.basketAccent}}" /></view>
        <view class="conv-hero__match-text">
          <text class="conv-hero__match-title">我手边有什么？</text>
          <text class="conv-hero__match-sub">勾勾材料，看看能调什么</text>
        </view>
        <image class="ico ico-sm" src="{{icons.arrowAccent}}" />
      </view>
    </view>

    <view class="conv-scenes">
      <scroll-view scroll-x class="conv-scenes__scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="conv-scene {{convScene === item.key ? 'active' : ''}}"
          wx:for="{{convScenes}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="selectConvScene"
        >{{item.label}}</view>
      </scroll-view>
    </view>

    <view class="conv-pitfall-entry card" bindtap="goPitfalls">
      <view class="conv-pitfall-entry__icon"><image class="ico" src="{{icons.warnAccent}}" /></view>
      <view class="conv-pitfall-entry__text">
        <text class="conv-pitfall-entry__title">新手避坑指南</text>
        <text class="conv-pitfall-entry__sub">这几个组合千万别乱调</text>
      </view>
      <text class="conv-pitfall-entry__arrow">›</text>
    </view>

    <view class="toolbar">
      <view class="toolbar__count">共 <text class="fw-600 conv-accent">{{convDrinks.length}}</text> 款</view>
      <view class="conv-toolbar__hint">好上手 · 零失败</view>
    </view>

    <view class="grid conv-grid">
      <view class="grid__col" wx:for="{{convDrinks}}" wx:key="id">
        <convenience-card drink="{{item}}"></convenience-card>
      </view>
    </view>
  </block>

  <view class="drink-disclaimer">未成年人请勿饮酒 · 理性饮酒</view>
  <view class="safe-bottom"></view>
</view>
