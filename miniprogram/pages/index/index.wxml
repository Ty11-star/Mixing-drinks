<view class="page-wrap index">

  <!-- 顶部 Hero -->
  <view class="hero">
    <view class="hero__bar">
      <view class="hero__title">
        <text class="hero__zh">调一杯</text>
        <text class="hero__en">MIX · SIP · REPEAT</text>
      </view>
      <view class="hero__search ripple-btn" bindtap="goSearch">
        <text class="hero__search-icon">🔍</text>
        <text class="hero__search-text">搜鸡尾酒 / 基酒</text>
      </view>
    </view>
    <view class="hero__cta" bindtap="goIngredient">
      <view class="hero__cta-text">
        <text class="hero__cta-title">调一杯，试试看？</text>
        <text class="hero__cta-sub">选一下手头的材料，马上推荐</text>
      </view>
      <text class="hero__cta-arrow">→</text>
    </view>
  </view>

  <!-- 基酒筛选（流动标签） -->
  <view class="spirit-tabs">
    <scroll-view scroll-x class="spirit-tabs__scroll" enhanced show-scrollbar="{{false}}">
      <view
        class="spirit-tab {{baseSpirit === item.name ? 'active' : ''}}"
        wx:for="{{spirits}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="selectSpirit"
      >
        <text>{{item.label}}</text>
        <text class="spirit-tab__count" wx:if="{{item.count !== undefined}}">{{item.count}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 列表工具条 -->
  <view class="toolbar">
    <view class="toolbar__count">共 <text class="text-amber fw-600">{{total}}</text> 款</view>
    <view class="toolbar__view" bindtap="toggleView">
      <text>{{viewMode === 'grid' ? '▦ 网格' : '☰ 列表'}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <pour-loading wx:if="{{loading && list.length === 0}}" text="正在调酒…"></pour-loading>

  <!-- 空态 -->
  <empty-state
    wx:elif="{{!loading && list.length === 0}}"
    icon="🍹"
    title="暂无可调之酒"
    description="换个基酒试试，或先去添加你手头的材料"
    show-action="{{true}}"
    action-text="去调一杯"
    bind:action="goIngredient"
  ></empty-state>

  <!-- 网格视图 -->
  <view class="grid" wx:elif="{{viewMode === 'grid'}}">
    <view class="grid__col" wx:for="{{list}}" wx:key="id">
      <cocktail-card cocktail="{{item}}"></cocktail-card>
    </view>
  </view>

  <!-- 列表视图 -->
  <view class="list" wx:else>
    <view class="list-row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="list-row__img" style="background:{{item._gradient}}">
        <image wx:if="{{item.image}}" class="list-row__photo" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <text wx:else class="list-row__icon">{{item._icon}}</text>
      </view>
      <view class="list-row__info">
        <view class="list-row__name ellipsis">{{item.name}}</view>
        <view class="list-row__sub ellipsis">{{item.nameEn}}</view>
        <view class="list-row__foot">
          <text class="list-row__spirit">{{item.baseSpirit}}</text>
          <text class="list-row__glass">{{item._diff.glass}} {{item._diff.label}}</text>
        </view>
        <view class="cocktail-card__taste" wx:if="{{item._taste.length}}">
          <text wx:for="{{item._taste}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 触底提示 -->
  <view class="load-more" wx:if="{{list.length > 0}}">
    <text wx:if="{{loading}}">倒酒中…</text>
    <text wx:elif="{{finished}}">— 到底啦 —</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <view class="safe-bottom"></view>
</view>
