.index { padding: 0; }

/* —— Hero —— */
.hero {
  background: linear-gradient(160deg, var(--midnight-blue, #1A2332) 0%, #25344A 60%, var(--slate-blue, #3D5A7B) 100%);
  padding: 28rpx 32rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--primary-amber-glow, rgba(212,165,116,0.25)), transparent 70%);
}
.hero__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.hero__title {
  display: flex;
  flex-direction: column;
}
.hero__zh {
  font-family: var(--font-display, serif);
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.04em;
}
.hero__en {
  font-size: 18rpx;
  letter-spacing: 0.3em;
  color: var(--primary-amber-light, #E5C4A0);
  margin-top: 4rpx;
}
.hero__search {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-round, 9999rpx);
  padding: 14rpx 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  position: relative;
}
.hero__search-icon { font-size: 24rpx; }

.hero__cta {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-lg, 24rpx);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero__cta-text { display: flex; flex-direction: column; gap: 4rpx; }
.hero__cta-title { color: #FFFFFF; font-size: 30rpx; font-weight: 600; }
.hero__cta-sub { color: rgba(255, 255, 255, 0.7); font-size: 22rpx; }
.hero__cta-arrow { color: var(--primary-amber, #D4A574); font-size: 40rpx; }

/* —— 基酒筛选 —— */
.spirit-tabs {
  margin-top: -28rpx;
  padding: 0 16rpx;
}
.spirit-tabs__scroll {
  white-space: nowrap;
}
.spirit-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 8rpx;
  padding: 16rpx 28rpx;
  background: #FFFFFF;
  border-radius: var(--radius-round, 9999rpx);
  font-size: 26rpx;
  color: var(--slate-blue, #3D5A7B);
  box-shadow: var(--shadow-glass-light, 0 4rpx 12rpx rgba(26,35,50,0.08));
  transition: all 0.25s;
}
.spirit-tab.active {
  background: linear-gradient(135deg, var(--primary-amber, #D4A574), var(--primary-amber-dark, #B8935E));
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx var(--primary-amber-glow, rgba(212,165,116,0.25));
}
.spirit-tab__count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* —— 工具条 —— */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.toolbar__count { font-size: 26rpx; color: var(--slate-blue, #3D5A7B); }
.toolbar__view {
  font-size: 24rpx;
  color: var(--slate-blue, #3D5A7B);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--ice-blue, #E8F1F5);
  border-radius: var(--radius-round, 9999rpx);
}

/* —— 网格 —— */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}
.grid__col {
  width: calc(50% - 8rpx);
}

/* —— 列表 —— */
.list {
  padding: 16rpx 32rpx;
}
.list-row {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-glass-light, 0 4rpx 12rpx rgba(26,35,50,0.08));
}
.list-row:active { transform: scale(0.99); }
.list-row__img {
  flex: 0 0 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md, 16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.list-row__icon {
  font-size: 72rpx;
  line-height: 1;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}
.list-row__photo {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.list-row__info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.list-row__name { font-family: var(--font-display, serif); font-size: 32rpx; font-weight: 600; color: var(--midnight-blue, #1A2332); }
.list-row__sub { font-size: 22rpx; color: var(--slate-blue, #3D5A7B); opacity: 0.8; }
.list-row__foot { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.list-row__spirit {
  font-size: 22rpx; color: var(--primary-amber-dark, #B8935E);
  background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  padding: 2rpx 12rpx; border-radius: var(--radius-xs, 8rpx);
}
.list-row__glass { font-size: 22rpx; color: var(--slate-blue, #3D5A7B); }

/* —— 触底 —— */
.load-more {
  text-align: center;
  color: var(--slate-blue, #3D5A7B);
  font-size: 24rpx;
  padding: 28rpx 0;
}
