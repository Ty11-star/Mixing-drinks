.index { padding: 0; }

/* —— 模式切换：玻璃胶囊 —— */
.switch-wrap {
  background: transparent;
  padding: calc(24rpx + env(safe-area-inset-top)) 0 12rpx;
}
.mode-switch {
  display: flex;
  margin: 0 48rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 9999rpx;
  padding: 8rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.mode-switch__item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 9999rpx;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: var(--text-3);
  transition: all var(--dur) var(--ease);
}
.mode-switch__item.is-active {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5), 0 8rpx 24rpx var(--accent-glow);
}
.index--conv .switch-wrap { padding-bottom: 0; }

/* —— 沉浸 Hero —— */
.hero {
  position: relative;
  margin: 12rpx 0 0;
  padding: 56rpx 48rpx 64rpx;
  min-height: 880rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    var(--hero-gradient),
    radial-gradient(ellipse 700rpx 500rpx at 92% 8%, var(--orb-warm), transparent 70%),
    radial-gradient(ellipse 600rpx 500rpx at -12% 60%, var(--orb-cool), transparent 70%);
}
.hero__photo {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0.32;
  filter: saturate(0.72) blur(2rpx);
}
.hero__photo-veil {
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg, rgba(233,235,230,0.15) 0%, rgba(233,235,230,0.55) 55%, var(--bg) 100%);
}
.theme-dark .hero__photo { opacity: 0.26; filter: saturate(0.65) brightness(0.7); }
.theme-dark .hero__photo-veil {
  background: linear-gradient(180deg, rgba(10,20,27,0.2) 0%, rgba(10,20,27,0.62) 58%, var(--bg) 100%);
}
.hero__glow {
  position: absolute;
  width: 520rpx; height: 520rpx;
  right: -140rpx; top: 80rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent-glow), transparent 68%);
  filter: blur(60rpx);
  pointer-events: none;
}
.hero__bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.brandmark { display: flex; flex-direction: column; gap: 4rpx; }
.brandmark__zh {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 34rpx;
  letter-spacing: 0.22em;
  color: var(--text);
}
.brandmark__en {
  font-family: var(--font-mono);
  font-style: italic;
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: var(--accent);
}
.hero__mine {
  flex: 0 0 auto;
  width: 84rpx; height: 84rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: 50%;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.hero__copy {
  margin-top: auto;
  position: relative;
  z-index: 2;
}
.hero__kicker {
  display: flex; align-items: center; gap: 20rpx;
  margin-bottom: 32rpx;
}
.hero__kicker-line { width: 48rpx; height: 1rpx; background: var(--accent); opacity: 0.8; }
.hero__kicker text {
  font-family: var(--font-display);
  font-size: 22rpx;
  letter-spacing: 0.28em;
  color: var(--text-2);
}
.hero__title {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: 92rpx;
  line-height: 1.22;
  letter-spacing: 0.02em;
  color: var(--text);
}
.hero__title-em { color: var(--accent); font-style: normal; }
.hero__sub {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--text-2);
  letter-spacing: 0.04em;
  margin-top: 28rpx;
}
.search-pill {
  margin-top: 52rpx;
  height: 104rpx;
  border-radius: 9999rpx;
  display: flex; align-items: center; gap: 24rpx;
  padding: 0 40rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.search-pill text { font-size: 26rpx; color: var(--text-2); letter-spacing: 0.06em; }
.search-pill:active { transform: scale(0.98); }
.scroll-hint { display: flex; align-items: center; gap: 18rpx; margin-top: 44rpx; }
.scroll-hint__line {
  width: 1rpx; height: 44rpx;
  background: linear-gradient(var(--text-3), transparent);
}
.scroll-hint text { font-size: 20rpx; letter-spacing: 0.22em; color: var(--text-3); }

/* —— 区块 —— */
.section { margin-top: 24rpx; }
.section__head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 0 48rpx;
  margin-bottom: 28rpx;
}
.section__title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 44rpx;
  letter-spacing: 0.06em;
  color: var(--text);
}
.section__en {
  font-family: var(--font-mono);
  font-style: italic;
  font-size: 28rpx;
  color: var(--text-3);
  margin-left: 18rpx;
  letter-spacing: 0;
}
.section__more { font-size: 22rpx; letter-spacing: 0.1em; color: var(--text-3); }

/* —— 基酒筛选 —— */
.spirit-tabs { margin-top: 8rpx; padding: 0 32rpx; }
.spirit-tabs__scroll { white-space: nowrap; }
.spirit-tab {
  display: inline-flex;
  align-items: center;
  margin: 0 10rpx;
  padding: 18rpx 36rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  transition: all var(--dur) var(--ease);
}
.spirit-tab.active {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 12rpx 32rpx var(--accent-glow);
}

/* —— 工具条 —— */
.toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 36rpx 48rpx 12rpx;
}
.toolbar__count { font-size: 24rpx; letter-spacing: 0.06em; color: var(--text-3); }

/* —— 网格 —— */
.grid { display: flex; flex-wrap: wrap; padding: 8rpx 24rpx; }
.grid__col { width: 50%; box-sizing: border-box; padding: 12rpx; }

/* —— 列表：横向大图卡片，风格对齐网格 —— */
.list {
  padding: 8rpx 24rpx;
  --radius-lg: 32rpx;
  --dur: 0.45s;
  --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
}
.list-card {
  position: relative;
  height: 320rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.list-card--hover {
  transform: translateY(-8rpx);
  box-shadow: var(--shadow-lifted);
}
.list-card__image {
  position: absolute;
  inset: 0;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.list-card__icon { font-size: 120rpx; line-height: 1; opacity: 0.85; }
.list-card__photo {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
  filter: saturate(0.9);
  transition: opacity 0.45s ease, transform 0.8s var(--ease);
}
.list-card__photo.is-loaded { opacity: 1; }
.list-card--hover .list-card__photo.is-loaded { transform: scale(1.04); }
.list-card__veil {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(28, 38, 36, 0.82) 0%, rgba(28, 38, 36, 0.45) 45%, transparent 100%);
}
.list-card__fav {
  position: absolute; top: 24rpx; right: 24rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.list-card__body {
  position: absolute; left: 36rpx; right: 36rpx; bottom: 36rpx;
  display: flex; flex-direction: column; gap: 4rpx;
}
.list-card__title {
  font-family: var(--font-display);
  font-weight: 400; font-size: 40rpx;
  letter-spacing: 0.06em;
  color: #FBF7EF;
}
.list-card__subtitle {
  font-family: var(--font-mono);
  font-style: italic; font-size: 26rpx;
  color: rgba(251, 247, 239, 0.72);
}
.list-card__desc {
  margin-top: 10rpx;
  display: flex; align-items: center; gap: 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.02em;
  color: rgba(251, 247, 239, 0.82);
}
.list-card__spirit {
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(251, 247, 239, 0.18);
  color: #FBF7EF;
}
.list-card__dot { opacity: 0.6; }

/* 深色模式：遮罩改为深蓝调 */
.theme-dark .list-card__veil {
  background: linear-gradient(90deg, rgba(6, 14, 20, 0.88) 0%, rgba(6, 14, 20, 0.48) 45%, transparent 100%);
}

.load-more {
  text-align: center; color: var(--text-3);
  font-size: 24rpx; letter-spacing: 0.1em;
  padding: 48rpx 0;
}

/* —— 引言 —— */
.quote-block {
  margin: 56rpx 48rpx 0;
  padding: 48rpx 44rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.quote-block text {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: 30rpx;
  line-height: 2;
  letter-spacing: 0.04em;
  color: var(--text-2);
}
.quote-block__em { color: var(--accent); }

/* ============ 便利店模式 ============ */
.conv-hero {
  position: relative;
  margin: 12rpx 32rpx 0;
  padding: 48rpx 44rpx 52rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background:
    radial-gradient(ellipse 500rpx 400rpx at 90% 0%, var(--orb-warm), transparent 70%),
    var(--conv-hero-gradient);
}
.conv-hero__glow {
  position: absolute; width: 400rpx; height: 400rpx;
  right: -100rpx; top: -80rpx; border-radius: 50%;
  background: radial-gradient(circle, var(--accent-glow), transparent 68%);
  filter: blur(50rpx);
}
.conv-hero__bar {
  display: flex; align-items: flex-start; justify-content: space-between;
  position: relative; z-index: 2;
}
.conv-hero__slogan {
  position: relative; z-index: 2;
  font-family: var(--font-display);
  font-size: 28rpx; color: var(--text-2);
  margin-top: 24rpx; letter-spacing: 0.04em;
}
.conv-hero__match {
  position: relative; z-index: 2;
  margin-top: 44rpx;
  display: flex; align-items: center; gap: 24rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.conv-hero__match-icon {
  flex: 0 0 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent-soft);
  border-radius: 24rpx;
}
.conv-hero__match-text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.conv-hero__match-title { font-family: var(--font-display); font-size: 30rpx; color: var(--text); }
.conv-hero__match-sub { font-size: 22rpx; color: var(--text-3); }

.conv-scenes { margin-top: 40rpx; padding: 0 32rpx; }
.conv-scenes__scroll { white-space: nowrap; }
.conv-scene {
  display: inline-flex; align-items: center;
  margin: 0 10rpx;
  padding: 18rpx 36rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  transition: all var(--dur) var(--ease);
}
.conv-scene.active {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 12rpx 32rpx var(--accent-glow);
}

.conv-pitfall-entry {
  display: flex; align-items: center; gap: 24rpx;
  margin: 40rpx 48rpx 0;
  padding: 28rpx 32rpx;
}
.conv-pitfall-entry__icon {
  flex: 0 0 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent-soft); border-radius: 50%;
}
.conv-pitfall-entry__text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.conv-pitfall-entry__title { font-family: var(--font-display); font-size: 28rpx; color: var(--text); }
.conv-pitfall-entry__sub { font-size: 22rpx; color: var(--text-3); }
.conv-pitfall-entry__arrow { font-size: 44rpx; color: var(--accent); }

.conv-accent { color: var(--accent); }
.conv-toolbar__hint { font-size: 22rpx; letter-spacing: 0.08em; color: var(--text-3); }
.conv-grid { margin-top: 4rpx; }
