.shake {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 0 calc(180rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.shake__head {
  flex: none;
  background:
    radial-gradient(ellipse 400rpx 300rpx at 88% 0%, var(--orb-warm), transparent 70%),
    var(--head-gradient);
  padding: calc(48rpx + env(safe-area-inset-top)) 48rpx 32rpx;
  border-radius: 0 0 56rpx 56rpx;
}
.shake__title { font-family: var(--font-display); font-size: 52rpx; font-weight: 400; letter-spacing: 0.04em; color: var(--text); }
.shake__sub { font-size: 24rpx; color: var(--text-2); margin-top: 10rpx; letter-spacing: 0.04em; }

/* 酒杯舞台（固定，不随原料滑动） */
.stage { flex: none; display: flex; flex-direction: column; align-items: center; padding: 32rpx 0 8rpx; }
.glass {
  width: 280rpx; height: 340rpx;
  position: relative;
  border: 5rpx solid rgba(168, 120, 68, 0.38);
  border-top: none;
  border-radius: 24rpx 24rpx 90rpx 90rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(216, 185, 142, 0.12));
  box-shadow: inset 0 12rpx 24rpx rgba(255, 255, 255, 0.7), inset 0 -16rpx 30rpx rgba(168, 120, 68, 0.1), 0 16rpx 40rpx rgba(52, 68, 60, 0.14);
}
.glass::before {
  content: ''; position: absolute; top: 0; left: 16rpx; width: 30rpx; height: 76%;
  background: linear-gradient(to bottom, rgba(255,255,255,0.75), rgba(255,255,255,0));
  border-radius: 20rpx; z-index: 2; pointer-events: none;
}
/* 酒柱：倒入时从顶部落下的材料色细流 */
.glass__stream {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 8rpx; height: 100%; opacity: 0.85;
  animation: stream 0.6s ease forwards;
  z-index: 3;
}
@keyframes stream {
  0% { height: 0; opacity: 0; }
  25% { height: 100%; opacity: 0.85; }
  100% { height: 100%; opacity: 0; }
}
.glass__liquid {
  position: absolute; left: 0; right: 0; bottom: 0; height: 0;
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.6s;
  z-index: 1;
}
/* 液面波纹（顶部高光弯月面） */
.glass__liquid::after {
  content: ''; position: absolute; top: -8rpx; left: 0; right: 0; height: 16rpx;
  background: rgba(255, 255, 255, 0.4); border-radius: 50%; filter: blur(2rpx);
}
.glass__shine {
  position: absolute; top: 8rpx; left: 24rpx; width: 36rpx; height: 70%;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
  border-radius: 20rpx; opacity: 0.5; z-index: 2;
}
.glass__rim {
  position: absolute; top: 0; left: -6rpx; right: -6rpx; height: 14rpx;
  background: rgba(255, 255, 255, 0.5); border-radius: 8rpx; z-index: 4;
}
.glass__pourtag {
  position: absolute; top: -46rpx; left: 50%; transform: translateX(-50%);
  background: var(--accent); color: #FFFFFF;
  font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 9999rpx;
  animation: pourpop 0.65s ease; z-index: 5;
}
@keyframes pourpop {
  0% { opacity: 0; transform: translate(-50%, 10rpx); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -20rpx); }
}
.glass__spark {
  position: absolute; top: 30rpx; right: 30rpx;
  font-size: 44rpx; z-index: 6;
  animation: spark 0.9s ease;
}
@keyframes spark {
  0% { opacity: 0; transform: scale(0.4) rotate(-20deg); }
  50% { opacity: 1; transform: scale(1.2) rotate(10deg); }
  100% { opacity: 0; transform: scale(1) rotate(0); }
}
.glass--pour { animation: glasspop 0.4s ease; box-shadow: inset 0 0 30rpx rgba(255,255,255,0.15), 0 0 26rpx var(--primary-amber-glow, rgba(212,165,116,0.5)); }
@keyframes glasspop {
  0% { transform: scale(1); }
  40% { transform: scale(1.04); }
  100% { transform: scale(1); }
}
.glass--shake { animation: glassshake 0.9s ease; }
@keyframes glassshake {
  0%, 100% { transform: rotate(0); }
  15% { transform: rotate(-8deg) translateX(-10rpx); }
  30% { transform: rotate(8deg) translateX(10rpx); }
  45% { transform: rotate(-8deg) translateX(-10rpx); }
  60% { transform: rotate(8deg) translateX(10rpx); }
  75% { transform: rotate(-4deg); }
  90% { transform: rotate(4deg); }
}
.bubble {
  position: absolute; bottom: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  animation: rise 2.4s linear infinite;
}
@keyframes rise {
  0% { transform: translateY(0); opacity: 0; }
  20% { opacity: 0.8; }
  100% { transform: translateY(-250rpx); opacity: 0; }
}
.stage__hint { font-size: 24rpx; color: var(--text-3); margin-top: 20rpx; letter-spacing: 0.06em; }

/* 已选 */
.picked { flex: none; display: flex; flex-wrap: wrap; gap: 14rpx; padding: 0 32rpx 10rpx; }
.picked__item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; background: var(--glass-strong);
  border: 1rpx solid var(--glass-border); border-radius: 9999rpx;
  font-size: 24rpx; color: var(--text);
}
.picked__x { color: var(--error); font-size: 20rpx; }
.picked__clear { padding: 10rpx 20rpx; font-size: 24rpx; color: var(--text-2); }

/* 可滚动材料区 */
.groups-label { flex: none; font-family: var(--font-display); font-size: 30rpx; font-weight: 600; color: var(--text); padding: 16rpx 32rpx 4rpx; }
.groups-scroll { flex: 1; height: 0; }
.groups { padding: 8rpx 32rpx 32rpx; }
.group__title { font-family: var(--font-display); font-size: 28rpx; font-weight: 600; color: var(--text); margin: 16rpx 0 14rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 30rpx; background: var(--glass-strong);
  border: 1rpx solid var(--glass-border); border-radius: 9999rpx;
  font-size: 27rpx; color: var(--text-2); transition: all 0.3s cubic-bezier(0.22,0.61,0.36,1);
}
.chip.on {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #FFFFFF; border-color: transparent;
  box-shadow: 0 6rpx 16rpx var(--primary-amber-glow, rgba(212, 165, 116, 0.25));
  transform: scale(1.03);
}

/* 底部摇酒栏：布局流内实底，不遮挡材料区 */
.shake-bar {
  flex: none;
  margin: 0 40rpx 16rpx;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 28rpx;
  height: 120rpx;
  border-radius: 9999rpx;
  background: var(--surface);
  border: 1rpx solid var(--glass-edge);
  box-shadow: 0 16rpx 48rpx rgba(52, 68, 60, 0.12);
  z-index: 60;
}
.shake-bar__count { font-size: 26rpx; color: var(--text-2); }
.shake-bar__btns { display: flex; gap: 16rpx; }
.shake-bar__btn {
  padding: 22rpx 40rpx;
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #FFFFFF; font-size: 28rpx; font-weight: 400; letter-spacing: 0.06em;
  border-radius: 9999rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.28), 0 16rpx 44rpx var(--accent-glow);
}
.shake-bar__btn--ghost {
  background: var(--glass-strong); color: var(--text-2);
  border: 1rpx solid var(--glass-border); box-shadow: none;
}
.shake-bar__btn.disabled { background: var(--glass); color: var(--text-3); opacity: 0.7; box-shadow: none; }
.shake-bar__btn:active { transform: scale(0.97); }
