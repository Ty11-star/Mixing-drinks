.match { padding: 0; }

.match__head {
  padding: 36rpx 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.match__title { font-family: var(--font-display); font-size: 44rpx; font-weight: 400; color: var(--text); }
.match__sub { font-size: 26rpx; color: var(--text-2); }

.match-card {
  display: flex;
  gap: 24rpx;
  margin: 20rpx 32rpx;
  padding: 28rpx;
  background: var(--glass-strong); border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border-left: 8rpx solid var(--accent);
  transition: transform 0.2s;
}
.match-card:active { transform: scale(0.99); }

/* 分层质感：匹配度越高，金色越浓 */
.match-card.tier-perfect { border-left-color: var(--accent); background: linear-gradient(135deg, var(--accent-soft), var(--surface) 60%); }
.match-card.tier-high { border-left-color: var(--primary-amber-light); background: linear-gradient(135deg, rgba(168,120,68,0.1), var(--surface) 65%); }
.match-card.tier-mid { border-left-color: var(--glass-border); }
.match-card.tier-low { border-left-color: var(--glass-border); opacity: 0.92; }

.match-card__rate {
  flex: 0 0 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx dashed var(--glass-border);
  padding-right: 12rpx;
}
.match-card__pct-wrap { display: flex; align-items: baseline; }
.match-card__pct {
  font-family: var(--font-mono, monospace);
  font-size: 60rpx;
  font-weight: 400;
  color: var(--accent-2);
  line-height: 1;
}
.match-card__sym { font-size: 28rpx; color: var(--accent-2); }
.match-card__tier { font-size: 22rpx; color: var(--text-2); margin-top: 10rpx; }

.match-card__info { flex: 1; min-width: 0; }
.match-card__name { font-family: var(--font-display); font-size: 34rpx; font-weight: 600; color: var(--text); }
.match-card__en { font-size: 22rpx; color: var(--text-2); opacity: 0.8; margin-bottom: 10rpx; }
.match-card__tags { display: flex; align-items: center; gap: 14rpx; }
.match-card__glass { font-size: 22rpx; color: var(--text-2); }
.match-card__taste { margin-top: 12rpx; font-size: 22rpx; color: var(--text-2); }
/* WXSS 不支持 :not()，用 :first-child 反向覆盖实现 */
.match-card__taste text::before { content: '·'; margin: 0 8rpx; color: var(--glass-border); }
.match-card__taste text:first-child::before { content: ''; margin: 0; }

.match-card__missing {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--glass-border);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  color: var(--text-2);
}
.match-card__missing-label { font-weight: 600; color: var(--error); }
.match-card__missing-item { color: var(--text); }
