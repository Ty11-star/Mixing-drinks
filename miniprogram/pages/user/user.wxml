<view class="page-wrap user">
  <!-- 个人资料 -->
  <view class="profile">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" lazy-load="{{true}}" show-menu-by-longpress="{{false}}"></image>
      <view wx:else class="avatar-ph">{{nickname ? nickname[0] : '客'}}</view>
    </button>
    <view class="profile__info">
      <input
        class="profile__nick"
        type="nickname"
        placeholder="点击设置昵称"
        placeholder-class="profile__ph"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        bindblur="saveProfile"
      />
      <view class="profile__status">{{userInfo ? '已完善资料' : '游客模式'}}</view>
    </view>
  </view>

  <view class="login-row">
    <button class="login-btn ripple-btn" bindtap="showLoginModal">{{token ? '重新授权登录' : '微信登录'}}</button>
  </view>
  <view class="privacy-row" bindtap="openPrivacyContract">查看《用户隐私保护指引》</view>

  <view class="my-recipes-entry" bindtap="goMyRecipes">
    <text>我的 AI 配方（{{myRecipeCount}}）</text>
    <text class="my-recipes-entry__arrow">›</text>
  </view>

  <!-- 我的收藏 -->
  <view class="section">
    <view class="section__head">
      <text class="section__title">我的收藏</text>
      <text class="section__count">{{favorites.length}}</text>
    </view>
    <empty-state
      wx:if="{{favorites.length === 0}}"
      icon="♡"
      title="还没有收藏"
      description="在酒谱详情页点击收藏，就会出现在这里"
    ></empty-state>
    <view class="grid" wx:else>
      <view class="grid__col" wx:for="{{favorites}}" wx:key="id">
        <cocktail-card cocktail="{{item}}"></cocktail-card>
      </view>
    </view>
  </view>

  <!-- 浏览历史 -->
  <view class="section">
    <view class="section__head">
      <text class="section__title">浏览历史</text>
      <text class="section__clear" wx:if="{{history.length}}" bindtap="clearHistory">清空</text>
    </view>
    <empty-state
      wx:if="{{history.length === 0}}"
      icon="🕒"
      title="还没有记录"
      description="看看首页，调一杯试试"
    ></empty-state>
    <view class="grid" wx:else>
      <view class="grid__col" wx:for="{{history}}" wx:key="id">
        <cocktail-card cocktail="{{item}}"></cocktail-card>
      </view>
    </view>
  </view>

  <!-- 登录授权弹窗：收集微信头像与昵称 -->
  <view class="auth-mask" wx:if="{{showAuthModal}}" bindtap="hideLoginModal">
    <view class="auth-modal" catchtap="noop">
      <view class="auth-modal__title">完善个人信息</view>
      <view class="auth-modal__desc">登录后可使用收藏、 AI 配方等功能。请授权你的头像和昵称。</view>

      <button class="auth-modal__avatar" open-type="chooseAvatar" bind:chooseavatar="onAuthChooseAvatar">
        <image wx:if="{{authAvatarUrl}}" src="{{authAvatarUrl}}" class="auth-modal__avatar-img" mode="aspectFill"></image>
        <view wx:else class="auth-modal__avatar-ph">＋</view>
      </button>
      <view class="auth-modal__avatar-tip">点击选择头像（可选）</view>

      <view class="auth-modal__field">
        <text class="auth-modal__label">昵称</text>
        <input
          class="auth-modal__input"
          type="nickname"
          placeholder="请输入昵称"
          placeholder-class="auth-modal__input-ph"
          value="{{authNickname}}"
          bindinput="onAuthNicknameInput"
        />
      </view>

      <view class="auth-modal__privacy">
        登录即表示同意 <text class="auth-modal__link" bindtap="openPrivacyContract">《用户隐私保护指引》</text>
      </view>

      <view class="auth-modal__actions">
        <button class="auth-modal__btn auth-modal__btn--cancel" bindtap="hideLoginModal">取消</button>
        <button class="auth-modal__btn auth-modal__btn--confirm" bindtap="confirmAuth">同意并登录</button>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
