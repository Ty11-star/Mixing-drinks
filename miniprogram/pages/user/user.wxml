<view class="page-wrap user {{isDark ? 'theme-dark' : ''}}">
  <!-- 顶部信息 -->
  <view class="profile">
    <view class="profile__avatar">调</view>
    <view class="profile__info">
      <view class="profile__nick">我的酒单</view>
      <view class="profile__status">收藏与记录均保存在本机</view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section">
    <view class="section__head">
      <text class="section__title">我的收藏</text>
      <text class="section__count">{{favorites.length}}</text>
    </view>
    <empty-state
      wx:if="{{favorites.length === 0}}"
      icon="♡"
      title="还没有收藏"
      description="在酒谱详情页点击收藏，就会出现在这里"
    ></empty-state>
    <view class="grid" wx:else>
      <view class="grid__col" wx:for="{{favorites}}" wx:key="id">
        <cocktail-card cocktail="{{item}}"></cocktail-card>
      </view>
    </view>
  </view>

  <!-- 备案信息 -->
  <view class="footer-info">
    <view class="footer-info__brand">调一杯 · MIX SIP REPEAT</view>
    <view class="footer-info__beian">粤ICP备2026181317号-2X</view>
    <view class="footer-info__beian footer-info__beian--police" bindtap="copyBeian">
      <text class="footer-info__badge">🛡</text> 粤公网安备44130202001841号
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
