.user { padding: 0; }

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background:
    radial-gradient(ellipse 400rpx 300rpx at 88% 0%, var(--orb-warm), transparent 70%),
    var(--head-gradient);
  padding: calc(56rpx + env(safe-area-inset-top)) 48rpx 64rpx;
  border-radius: 0 0 56rpx 56rpx;
}
.profile__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 400;
  color: var(--accent);
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.profile__info { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }
.profile__nick {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: var(--text);
}
.profile__status { font-size: 24rpx; color: var(--text-2); }

.section { padding: 36rpx 32rpx 0; }
.section__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section__title { font-family: var(--font-display); font-size: 34rpx; font-weight: 600; color: var(--text); }
.section__count {
  font-size: 24rpx;
  color: var(--accent-2);
  background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  padding: 2rpx 16rpx;
  border-radius: var(--radius-round, 9999rpx);
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid__col {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

/* 备案信息 */
.footer-info {
  text-align: center;
  padding: 48rpx 32rpx 24rpx;
  margin-top: 40rpx;
  border-top: 1rpx solid var(--glass-border);
}
.footer-info__brand {
  font-family: var(--font-display);
  font-size: 24rpx;
  color: var(--text-2);
  opacity: 0.7;
  margin-bottom: 10rpx;
}
.footer-info__beian {
  font-size: 22rpx;
  color: #9AA7B5;
}
.footer-info__beian--police {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.footer-info__badge {
  font-size: 24rpx;
}
