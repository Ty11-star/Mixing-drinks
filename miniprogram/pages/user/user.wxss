.user { padding: 0; }

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(160deg, var(--midnight-blue, #1A2332), var(--slate-blue, #3D5A7B));
  padding: 56rpx 32rpx 64rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.avatar-btn {
  margin: 0;
  padding: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 128rpx; height: 128rpx; }
.avatar-ph {
  font-family: var(--font-display, serif);
  font-size: 56rpx;
  color: #FFFFFF;
}
.profile__info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.profile__nick {
  font-family: var(--font-display, serif);
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: transparent;
  padding: 0;
  height: 52rpx;
}
.profile__ph { color: rgba(255, 255, 255, 0.6); font-weight: 400; }
.profile__status { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); }

.login-row { padding: 28rpx 32rpx 0; }
.login-btn {
  background: rgba(255, 255, 255, 0.12);
  color: var(--primary-amber-light, #E5C4A0);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: var(--radius-sm, 12rpx);
  font-size: 28rpx;
  font-weight: 600;
}
.login-btn::after { border: none; }

.privacy-row {
  text-align: center;
  font-size: 24rpx;
  color: var(--slate-blue, #3D5A7B);
  padding: 20rpx 32rpx 0;
  text-decoration: underline;
}

.my-recipes-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--ice-blue, #E8F1F5);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--midnight-blue, #1A2332);
}
.my-recipes-entry__arrow { font-size: 36rpx; color: var(--primary-amber-dark, #B8935E); }

.section { padding: 36rpx 32rpx 0; }
.section__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section__title { font-family: var(--font-display, serif); font-size: 34rpx; font-weight: 600; color: var(--midnight-blue, #1A2332); }
.section__count {
  font-size: 24rpx;
  color: var(--primary-amber-dark, #B8935E);
  background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  padding: 2rpx 16rpx;
  border-radius: var(--radius-round, 9999rpx);
}
.section__clear { font-size: 24rpx; color: var(--slate-blue, #3D5A7B); }

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid__col { width: calc(50% - 8rpx); }

/* 登录授权弹窗 */
.auth-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 35, 50, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.auth-modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(26, 35, 50, 0.25);
}
.auth-modal__title {
  font-family: var(--font-display, serif);
  font-size: 38rpx;
  font-weight: 600;
  color: var(--midnight-blue, #1A2332);
  text-align: center;
}
.auth-modal__desc {
  font-size: 26rpx;
  color: var(--slate-blue, #3D5A7B);
  line-height: 1.6;
  text-align: center;
  margin: 16rpx 0 32rpx;
}
.auth-modal__avatar {
  margin: 0 auto;
  padding: 0;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--ice-blue, #E8F1F5);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.auth-modal__avatar::after { border: none; }
.auth-modal__avatar-img { width: 144rpx; height: 144rpx; }
.auth-modal__avatar-ph {
  font-size: 64rpx;
  color: var(--primary-amber-dark, #B8935E);
  line-height: 1;
}
.auth-modal__avatar-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--slate-blue, #3D5A7B);
  margin-top: 12rpx;
}
.auth-modal__field {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 24rpx;
  height: 88rpx;
  background: var(--bg-secondary, #F8FAFB);
  border: 1rpx solid var(--ice-blue, #E8F1F5);
  border-radius: 12rpx;
}
.auth-modal__label {
  font-size: 28rpx;
  color: var(--midnight-blue, #1A2332);
  width: 80rpx;
}
.auth-modal__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--midnight-blue, #1A2332);
}
.auth-modal__input-ph { color: #B0BBC7; }
.auth-modal__privacy {
  font-size: 22rpx;
  color: var(--slate-blue, #3D5A7B);
  text-align: center;
  margin: 28rpx 0 8rpx;
}
.auth-modal__link { color: var(--primary-amber-dark, #B8935E); text-decoration: underline; }
.auth-modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.auth-modal__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}
.auth-modal__btn::after { border: none; }
.auth-modal__btn--cancel {
  background: #FFFFFF;
  color: var(--slate-blue, #3D5A7B);
  border: 1rpx solid var(--ice-blue, #E8F1F5);
}
.auth-modal__btn--confirm {
  background: linear-gradient(135deg, var(--primary-amber, #D4A574), var(--primary-amber-dark, #B8935E));
  color: #FFFFFF;
  border: none;
}
