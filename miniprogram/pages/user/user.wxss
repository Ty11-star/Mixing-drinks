.user { padding: 0; }

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(160deg, var(--midnight-blue, #1A2332), var(--slate-blue, #3D5A7B));
  padding: 56rpx 32rpx 64rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.profile__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display, serif);
  font-size: 56rpx;
  color: #FFFFFF;
}
.profile__info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.profile__nick {
  font-family: var(--font-display, serif);
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.profile__status { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); }

.section { padding: 36rpx 32rpx 0; }
.section__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section__title { font-family: var(--font-display, serif); font-size: 34rpx; font-weight: 600; color: var(--midnight-blue, #1A2332); }
.section__count {
  font-size: 24rpx;
  color: var(--primary-amber-dark, #B8935E);
  background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  padding: 2rpx 16rpx;
  border-radius: var(--radius-round, 9999rpx);
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid__col {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

/* 备案信息 */
.footer-info {
  text-align: center;
  padding: 48rpx 32rpx 24rpx;
  margin-top: 40rpx;
  border-top: 1rpx solid var(--ice-blue, #E8F1F5);
}
.footer-info__brand {
  font-family: var(--font-display, serif);
  font-size: 24rpx;
  color: var(--slate-blue, #3D5A7B);
  opacity: 0.7;
  margin-bottom: 10rpx;
}
.footer-info__beian {
  font-size: 22rpx;
  color: #9AA7B5;
}
.footer-info__beian--police {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.footer-info__badge {
  font-size: 24rpx;
}
