.user { padding: 0; }

.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(160deg, var(--midnight-blue, #1A2332), var(--slate-blue, #3D5A7B));
  padding: 56rpx 32rpx 64rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.avatar-btn {
  margin: 0;
  padding: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 128rpx; height: 128rpx; }
.avatar-ph {
  font-family: var(--font-display, serif);
  font-size: 56rpx;
  color: #FFFFFF;
}
.profile__info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.profile__nick {
  font-family: var(--font-display, serif);
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: transparent;
  padding: 0;
  height: 52rpx;
}
.profile__ph { color: rgba(255, 255, 255, 0.6); font-weight: 400; }
.profile__status { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); }

.login-row { padding: 28rpx 32rpx 0; }
.login-btn {
  background: rgba(255, 255, 255, 0.12);
  color: var(--primary-amber-light, #E5C4A0);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: var(--radius-sm, 12rpx);
  font-size: 28rpx;
  font-weight: 600;
}
.login-btn::after { border: none; }

.section { padding: 36rpx 32rpx 0; }
.section__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section__title { font-family: var(--font-display, serif); font-size: 34rpx; font-weight: 600; color: var(--midnight-blue, #1A2332); }
.section__count {
  font-size: 24rpx;
  color: var(--primary-amber-dark, #B8935E);
  background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  padding: 2rpx 16rpx;
  border-radius: var(--radius-round, 9999rpx);
}
.section__clear { font-size: 24rpx; color: var(--slate-blue, #3D5A7B); }

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid__col { width: calc(50% - 8rpx); }
