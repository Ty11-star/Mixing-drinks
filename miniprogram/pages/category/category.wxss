.filter-section {
  padding: 24rpx 32rpx 0;
}
.filter-section__title {
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--midnight-blue, #1A2332);
  margin-bottom: 16rpx;
}

.chip-scroll { white-space: nowrap; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 26rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--ice-blue, #E8F1F5);
  border-radius: var(--radius-round, 9999rpx);
  font-size: 26rpx;
  color: var(--slate-blue, #3D5A7B);
  transition: all 0.2s;
}
.chip.on {
  background: linear-gradient(135deg, var(--primary-amber, #D4A574), var(--primary-amber-dark, #B8935E));
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx var(--primary-amber-glow, rgba(212,165,116,0.25));
}
.chip__count { font-size: 20rpx; opacity: 0.7; }

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.result-bar__count { font-size: 26rpx; color: var(--slate-blue, #3D5A7B); }
.result-bar__reset { font-size: 24rpx; color: var(--primary-amber-dark, #B8935E); }

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}
.grid__col { width: calc(50% - 8rpx); }
