.filter-section {
  padding: 24rpx 32rpx 0;
}
.filter-section__title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.chip-scroll { white-space: nowrap; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 26rpx;
  background: var(--glass-strong); border: 1rpx solid var(--glass-border);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-round, 9999rpx);
  font-size: 26rpx;
  color: var(--text-2);
  transition: all 0.2s;
}
.chip.on {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx var(--accent-glow);
}
.chip__count { font-size: 20rpx; opacity: 0.7; }

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.result-bar__count { font-size: 26rpx; color: var(--text-2); }
.result-bar__reset { font-size: 24rpx; color: var(--accent-2); }

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 12rpx;
}
.grid__col {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}
