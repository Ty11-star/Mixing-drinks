<view class="page-wrap">
  <pour-loading wx:if="{{loading}}" text="正在分类…"></pour-loading>

  <block wx:else>
    <!-- 基酒 -->
    <view class="filter-section">
      <view class="filter-section__title">基酒</view>
      <scroll-view scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="chip {{sel.spirit === item.name ? 'on' : ''}}"
          wx:for="{{spirits}}" wx:key="name"
          data-name="{{item.name}}" bindtap="selectSpirit"
        >{{item.name}}<text class="chip__count" wx:if="{{item.cocktailCount !== undefined}}">{{item.cocktailCount}}</text></view>
      </scroll-view>
    </view>

    <!-- 口味 -->
    <view class="filter-section">
      <view class="filter-section__title">口味</view>
      <view class="chip-wrap">
        <view
          class="chip {{sel.taste === item.name ? 'on' : ''}}"
          wx:for="{{tastes}}" wx:key="name"
          data-name="{{item.name}}" bindtap="selectTaste"
        >{{item.name}}</view>
      </view>
    </view>

    <!-- 难度 -->
    <view class="filter-section">
      <view class="filter-section__title">难度</view>
      <view class="chip-wrap">
        <view
          class="chip {{sel.difficulty === item.v ? 'on' : ''}}"
          wx:for="{{difficulties}}" wx:key="v"
          data-v="{{item.v}}" bindtap="selectDiff"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="result-bar">
      <text class="result-bar__count">找到 <text class="text-amber fw-600">{{list.length}}</text> 款</text>
      <text class="result-bar__reset" wx:if="{{sel.spirit || sel.difficulty || sel.taste}}" bindtap="reset">重置</text>
    </view>

    <empty-state
      wx:if="{{list.length === 0}}"
      icon="🍃"
      title="没有符合条件的酒"
      description="试着减少筛选条件"
    ></empty-state>

    <view class="grid" wx:else>
      <view class="grid__col" wx:for="{{list}}" wx:key="id">
        <cocktail-card cocktail="{{item}}"></cocktail-card>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </block>
</view>
