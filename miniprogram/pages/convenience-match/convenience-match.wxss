.match-page { padding: 0 0 32rpx; }

.match-intro {
  padding: calc(48rpx + env(safe-area-inset-top)) 48rpx 40rpx;
  background:
    radial-gradient(ellipse 420rpx 320rpx at 88% 0%, var(--orb-warm), transparent 70%),
    var(--head-gradient);
  border-radius: 0 0 56rpx 56rpx;
}
.match-intro__title { font-family: var(--font-display); font-size: 46rpx; font-weight: 400; letter-spacing: 0.04em; color: var(--text); }
.match-intro__sub { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; letter-spacing: 0.04em; }

.match-group { padding: 40rpx 48rpx 0; }
.match-group__head {
  font-family: var(--font-display);
  font-size: 30rpx; font-weight: 400;
  letter-spacing: 0.06em; color: var(--text);
  margin-bottom: 24rpx;
}
.match-group__items { display: flex; flex-wrap: wrap; gap: 16rpx; }
.match-mat {
  display: flex; align-items: center; gap: 10rpx;
  padding: 16rpx 28rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  transition: all var(--dur) var(--ease);
}
.match-mat.is-selected {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  border-color: transparent;
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx var(--accent-glow);
}
.match-mat__emoji { font-size: 30rpx; }
.match-mat__check { color: #FFFFFF; font-weight: 600; }

.match-result { padding: 56rpx 48rpx 0; }
.match-result__head { font-family: var(--font-display); font-size: 36rpx; font-weight: 400; letter-spacing: 0.04em; color: var(--text); margin-bottom: 24rpx; }
.match-result__count { font-size: 24rpx; color: var(--text-3); font-weight: 400; }

.match-empty { text-align: center; padding: 80rpx 0; }
.match-empty__icon { font-size: 100rpx; }
.match-empty__title { font-family: var(--font-display); font-size: 32rpx; color: var(--text-2); margin-top: 24rpx; }
.match-empty__sub { font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; }

.match-item {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: inset 0 1rpx 0 var(--glass-hi), var(--shadow-sm);
}
.match-item__emoji {
  flex: 0 0 112rpx; height: 112rpx;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
  background: var(--accent-soft);
}
.match-item__info { flex: 1; min-width: 0; }
.match-item__name { font-family: var(--font-display); font-size: 32rpx; font-weight: 400; color: var(--text); }
.match-item__sub { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.match-item__bar { height: 8rpx; background: var(--glass-border); border-radius: 999rpx; margin-top: 16rpx; overflow: hidden; }
.match-item__bar-fill { height: 100%; background: linear-gradient(90deg, var(--primary-amber-light), var(--accent)); border-radius: 999rpx; transition: width 0.4s var(--ease); }
.match-item__missing { font-size: 20rpx; color: var(--accent-2); margin-top: 12rpx; }
.match-item__ready { font-size: 20rpx; color: var(--accent); margin-top: 12rpx; }
.match-item__arrow { font-size: 40rpx; color: var(--accent); }
