.my-recipes { padding: 0 32rpx; }

.head { padding: 40rpx 0 28rpx; }
.head__title {
  font-family: var(--font-display, serif);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--midnight-blue, #1A2332);
}
.head__sub { font-size: 24rpx; color: var(--slate-blue, #6B8299); margin-top: 8rpx; }

.list { display: flex; flex-direction: column; gap: 20rpx; }
.card {
  background: #FFFFFF;
  border-radius: 18rpx;
  border: 1rpx solid var(--ice-blue, #E8F1F5);
  overflow: hidden;
}
.card__main { padding: 24rpx; }
.card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.card__name {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--midnight-blue, #1A2332);
  flex: 1;
}
.card__time { font-size: 22rpx; color: #9AA8B5; flex-shrink: 0; }
.card__meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.tag {
  font-size: 22rpx;
  color: var(--slate-blue, #3D5A7B);
  background: var(--ice-blue, #E8F1F5);
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}
.card__desc {
  font-size: 26rpx;
  color: var(--slate-blue, #3D5A7B);
  line-height: 1.6;
  margin-top: 14rpx;
}
.card__toggle { font-size: 22rpx; color: var(--primary-amber-dark, #B8935E); margin-top: 16rpx; }

.detail { padding: 8rpx 24rpx 24rpx; border-top: 1rpx dashed var(--ice-blue, #E8F1F5); }
.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-amber-dark, #B8935E);
  margin: 20rpx 0 10rpx;
}
.ing { display: flex; justify-content: space-between; font-size: 26rpx; color: var(--midnight-blue, #1A2332); padding: 6rpx 0; }
.ing__amount { color: #7B8FA3; }
.step { display: flex; gap: 14rpx; font-size: 26rpx; color: var(--midnight-blue, #1A2332); line-height: 1.6; padding: 6rpx 0; }
.step__no {
  width: 36rpx; height: 36rpx; flex-shrink: 0;
  border-radius: 50%; background: var(--primary-amber-glow, rgba(212,165,116,0.2));
  color: var(--primary-amber-dark, #B8935E);
  text-align: center; line-height: 36rpx; font-size: 22rpx;
}
.step__text { flex: 1; }
.tips { font-size: 24rpx; color: var(--slate-blue, #3D5A7B); margin-top: 16rpx; line-height: 1.6; }
.delete {
  text-align: center; font-size: 24rpx; color: #B45B5B;
  margin-top: 24rpx; padding: 16rpx; border-radius: 12rpx;
  background: #FFF6F6;
}
