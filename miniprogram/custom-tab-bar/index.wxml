<view class="tab-bar">
  <view class="tab-bar__indicator" style="width:{{100/list.length}}%;transform:translateX({{selected*100}}%);"></view>
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tab-item__icon">{{item.icon}}</text>
    <text class="tab-item__text">{{item.text}}</text>
  </view>
</view>
