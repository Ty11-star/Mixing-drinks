<view class="tabbar {{isDark ? 'theme-dark' : ''}}">
  <view
    class="tab {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab__ico" src="{{selected === index ? icons[item.icon + 'Accent'] : icons[item.icon]}}" />
    <text class="tab__text">{{item.text}}</text>
  </view>
</view>
